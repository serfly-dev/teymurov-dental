generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]

  @@index([sortOrder])
  @@index([isPublished])
}

model ServiceFaq {
  id        String   @id @default(cuid())
  serviceId String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  url       String
  alt       String?
  title     String?
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model DoctorService {
  doctorId  String
  serviceId String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorId, serviceId])
  @@index([serviceId])
}

model Service {
  id               String           @id @default(cuid())
  categoryId       String
  name             String
  slug             String           @unique
  description      String?
  isPublished      Boolean          @default(true)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  h1               String?
  seoDescription   String?
  seoTitle         String?
  shortDescription String?
  duration         String?
  seoKeywords      String?
  price            String?
  contactRequests  ContactRequest[]
  doctors          DoctorService[]
  category         ServiceCategory  @relation(fields: [categoryId], references: [id])
  blocks           ServiceBlock[]
  faqs             ServiceFaq[]
  images           ServiceImage[]
  lists            ServiceList[]

  @@index([categoryId])
  @@index([slug])
}

model ServiceList {
  id        String          @id @default(cuid())
  serviceId String
  type      ServiceListType
  title     String?
  text      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceBlock {
  id        String   @id @default(cuid())
  serviceId String
  title     String
  content   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole      @default(ADMIN)
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     UserSession[]
}

model UserSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Doctor {
  id              String              @id @default(cuid())
  fullName        String
  slug            String              @unique
  education       String?
  biography       String?
  h1              String?
  seoTitle        String?
  seoDescription  String?
  isPublished     Boolean             @default(true)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  careerStartYear Int?
  specialization  String
  experience      String?
  photo           String?
  certificates    DoctorCertificate[]
  services        DoctorService[]

  @@index([slug])
  @@index([isPublished])
  @@index([sortOrder])
}

model DoctorCertificate {
  id        String   @id @default(cuid())
  doctorId  String
  name      String
  image     String
  year      Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@index([sortOrder])
}

model Article {
  id             String          @id @default(cuid())
  categoryId     String
  title          String
  slug           String          @unique
  excerpt        String?
  content        String
  h1             String?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean         @default(false)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  image          String?
  sortOrder      Int             @default(0)
  category       ArticleCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([slug])
  @@index([sortOrder])
  @@index([isPublished])
}

model ContactRequest {
  id           String               @id @default(cuid())
  type         ContactRequestType
  name         String
  phone        String
  callbackTime CallbackTime
  serviceId    String?
  comment      String?
  status       ContactRequestStatus @default(NEW)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  service      Service?             @relation(fields: [serviceId], references: [id])

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([serviceId])
}

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  extension    String
  size         Int
  url          String   @unique
  alt          String?
  createdAt    DateTime @default(now())

  @@index([filename])
  @@index([originalName])
  @@index([createdAt])
  @@index([mimeType])
}

enum UserRole {
  ADMIN
  EDITOR
}

enum ServiceListType {
  BENEFIT
  INDICATION
  CONTRAINDICATION
  RECOMMENDATION
  STAGE
}

enum ContactRequestType {
  APPOINTMENT
  QUESTION
}

enum ContactRequestStatus {
  NEW
  CALLED
  COMPLETED
  CANCELED
}

enum CallbackTime {
  MORNING
  BEFORE_NOON
  AFTERNOON
  EVENING
  ANYTIME
}
